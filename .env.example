# Copy to .env (never commit .env). Read by the backend when run locally (make dev-back).
DATABASE_URL=postgresql+psycopg://merchantpay:merchantpay@localhost:5433/merchantpay
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_TTL_MINUTES=480
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
TIMEZONE=Africa/Algiers
# Freezes "today" for the demo (data ends 2026-11-20). Remove for real-time behaviour.
DEMO_TODAY=2026-11-20
